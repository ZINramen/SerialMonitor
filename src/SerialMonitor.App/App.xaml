<Application x:Class="SerialMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SerialMonitor.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- 색 -->
        <SolidColorBrush x:Key="WindowBackground" Color="#0E1116" />
        <SolidColorBrush x:Key="PanelBackground" Color="#161B23" />
        <SolidColorBrush x:Key="BorderColor"     Color="#242B36" />
        <SolidColorBrush x:Key="TextPrimary"     Color="#E3E9F2" />
        <SolidColorBrush x:Key="TextMuted"       Color="#8A94A6" />
        <SolidColorBrush x:Key="AccentColor"     Color="#3A7BD5" />

        <!-- 변환기 -->
        <local:InverseBoolConverter    x:Key="InverseBool" />
        <local:StateToBrushConverter   x:Key="StateToBrush" />
        <local:VerdictToBrushConverter x:Key="VerdictToBrush" />
        <local:VerdictToBadgeConverter x:Key="VerdictToBadge" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 통계 타일: Tag는 항목 이름, Content는 값 -->
        <Style x:Key="StatTile" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="10"
                                       Foreground="{StaticResource TextMuted}" />
                            <ContentPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource TextPrimary}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#222A36" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#2C3645" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="BorderBrush" Value="#4A8BE5" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="26" />
        </Style>

    </Application.Resources>
</Application>
